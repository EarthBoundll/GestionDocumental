# Dirección de la API. Todo lo que empieza por VITE_ acaba en el JavaScript que descarga el navegador:
# aquí nunca va un secreto.
VITE_API_URL=http://localhost:4000/api/v1

# Contacto público de la plataforma (D38), opcional: con él, el inicio de sesión ofrece «Solicita una cuenta»
# y las páginas de términos y privacidad lo muestran. Conviene un correo propio para esto, no el de la cuenta
# del Master. El WhatsApp, solo dígitos con el código del país (51 para Perú).
VITE_CONTACTO_EMAIL=
VITE_CONTACTO_WHATSAPP=
