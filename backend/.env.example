# Copia este archivo como .env y rellénalo. El .env no se sube a git.
NODE_ENV=development
PORT=4000

# Opción A · Proyecto «desarrollo» de Supabase: botón Connect → Session pooler (puerto 5432).
# Sin ?sslmode al final: el cifrado lo configura DATABASE_CA.
# Opción B · Un PostgreSQL instalado en esta máquina, por ejemplo:
#   postgresql://postgres:<clave>@localhost:5432/gestion_documental
DATABASE_URL=postgresql://postgres.<ref>:<clave>@<host-del-pooler>:5432/postgres

# Certificado de Supabase: Project Settings → Database → SSL Configuration → Download certificate.
# Pega el contenido completo entre comillas dobles, saltos de línea incluidos.
# Con una base local (opción B) se deja vacío.
DATABASE_CA=

# Secreto para firmar las sesiones (32 caracteres o más). Genera uno con:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
JWT_SECRETO=
JWT_DURACION_HORAS=8

# Orígenes que pueden llamar a la API desde el navegador, separados por comas.
CORS_ORIGEN=http://localhost:5173

# En local no hay proxies delante de la API.
PROXIES_DE_CONFIANZA=0
DIAGNOSTICO_RED=false

# Dónde se guardan los archivos. En local, una carpeta (D16); en producción, Supabase Storage.
ALMACENAMIENTO=disco
DIRECTORIO_ARCHIVOS=archivos
URL_PUBLICA=http://localhost:4000
# Solo con ALMACENAMIENTO=supabase:
SUPABASE_URL=
SUPABASE_CLAVE_SECRETA=
STORAGE_BUCKET=documentos
# Respaldos de la base (D25): bucket privado con supabase, carpeta con disco.
RESPALDOS_BUCKET=respaldos
DIRECTORIO_RESPALDOS=respaldos

# Correos de la plataforma: invitaciones, confirmación del correo y recuperación de contraseña (D41). En local
# se guardan en una carpeta y el enlace sale por la consola.
CORREO=archivo
DIRECTORIO_CORREOS=correos
# Solo con CORREO=brevo (producción): clave de la API de Brevo y un remitente verificado en su panel.
BREVO_CLAVE_API=
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=Gestión Documental
# Adonde apuntan los enlaces de los correos.
URL_FRONTEND=http://localhost:5173

# Administrador Master: solo los leen «npm run crear-master» y «npm run local».
# Valores de EJEMPLO: pon los tuyos en tu .env, nunca aquí. La contraseña necesita 12 caracteres o más,
# sin tu DNI, tu correo ni solo números.
MASTER_NOMBRE=Nombre Apellido
MASTER_EMAIL=master@ejemplo.pe
MASTER_DNI=00000000
MASTER_PASSWORD=

# Solo para «npm run documentos-de-prueba -- <carpeta> --subir» (D34): a qué API y con qué cuenta se suben los
# documentos ficticios. Valores de EJEMPLO: la cuenta real va en tu .env, nunca aquí.
CARGA_API_URL=http://localhost:4000
CARGA_EMAIL=administracion@ejemplo.pe
CARGA_CLAVE=
