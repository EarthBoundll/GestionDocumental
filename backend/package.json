{
  "name": "gestion-documental-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "local": "tsx --env-file-if-exists=.env scripts/local.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrar": "tsx --env-file-if-exists=.env scripts/migrar.ts",
    "crear-master": "tsx --env-file-if-exists=.env scripts/crear-master.ts",
    "comprobar-despliegue": "tsx scripts/comprobar-despliegue.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "informe:aislamiento": "tsx scripts/informe-aislamiento.ts",
    "informe:carga": "tsx scripts/informe-carga.ts",
    "respaldo": "tsx --env-file-if-exists=.env scripts/respaldo.ts"
  },
  "dependencies": {
    "@supabase/storage-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^17.10.0-beta.17",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": false,
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "@embedded-postgres/linux-x64@17.10.0-beta.17": true
  }
}
