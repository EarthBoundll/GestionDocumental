node_modules/
dist/
# Archivos subidos en desarrollo (ALMACENAMIENTO=disco).
backend/archivos/
# Correos de recuperación en desarrollo (CORREO=archivo): llevan enlaces válidos.
backend/correos/
# Respaldos de la base en desarrollo: llevan datos de todas las empresas.
backend/respaldos/
backend/respaldo-*.json.gz
# Base y archivos de «npm run local».
backend/.local/
coverage/
# Informe HTML de Playwright (npm run pruebas:informe): se regenera en cada ejecución.
frontend/informe-pruebas/
*.log

# Secretos: solo se versiona la plantilla.
.env
.env.*
!.env.example
